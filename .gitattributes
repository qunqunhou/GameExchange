# 默认识别文本文件并由 Git 统一处理换行符
* text=auto

# 跨平台源码与配置统一使用 LF
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.jsp text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
mvnw text eol=lf
Dockerfile* text eol=lf

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件禁止文本转换
*.class binary
*.jar binary
*.war binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
